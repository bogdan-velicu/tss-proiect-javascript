        <mxCell id="code" value="14&amp;nbsp;&amp;nbsp;addItem(name, price, quantity, category) {&#10;15&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;validateItem(name, price, quantity, category);&#10;&#10;18&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;currentTotal = this.getTotalItemCount();&#10;19&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if (currentTotal + quantity &amp;gt; MAX_ITEMS)&#10;20&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;throw new Error(...);&#10;&#10;24&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;existingItem = this.items.find(...);&#10;25&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if (existingItem) {&#10;26&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;newQuantity = existingItem.quantity + quantity;&#10;27&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if (newQuantity &amp;gt; MAX_QUANTITY_PER_ITEM)&#10;28&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;throw new Error(...);&#10;30&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;existingItem.quantity = newQuantity;&#10;31&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;existingItem.price = price;&#10;32&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;return existingItem;&#10;33&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;}&#10;&#10;35&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;newItem = { ... };&#10;42&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;this.items.push(newItem);&#10;43&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;return newItem;&#10;44&amp;nbsp;&amp;nbsp;}" style="text;html=1;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=10;strokeColor=#999;fillColor=#fafafa;whiteSpace=wrap;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
