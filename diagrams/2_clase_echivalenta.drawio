        <mxCell id="th_cat" value="&lt;b&gt;category&lt;/b&gt;" style="text;html=1;align=center;fontSize=12;strokeColor=#000000;fillColor=#f5f5f5;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="490" y="1020" width="130" height="30" as="geometry" />
        </mxCell>
        <mxCell id="th_exp" value="&lt;b&gt;Rezultat asteptat&lt;/b&gt;" style="text;html=1;align=center;fontSize=12;strokeColor=#000000;fillColor=#f5f5f5;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="620" y="1020" width="550" height="30" as="geometry" />
        </mxCell>

        <!-- Row G1 -->
        <mxCell id="r1c" value="G&lt;sub&gt;1&lt;/sub&gt;" style="text;html=1;align=center;fontSize=11;strokeColor=#000000;fillColor=#d5e8d4;" vertex="1" parent="1"><mxGeometry x="100" y="1050" width="60" height="28" as="geometry" /></mxCell>
        <mxCell id="r1n" value="'Laptop'" style="text;html=1;align=center;fontSize=11;strokeColor=#000000;fillColor=#d5e8d4;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="160" y="1050" width="130" height="28" as="geometry" /></mxCell>
        <mxCell id="r1p" value="999.99" style="text;html=1;align=center;fontSize=11;strokeColor=#000000;fillColor=#d5e8d4;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="290" y="1050" width="100" height="28" as="geometry" /></mxCell>
        <mxCell id="r1q" value="1" style="text;html=1;align=center;fontSize=11;strokeColor=#000000;fillColor=#d5e8d4;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="390" y="1050" width="100" height="28" as="geometry" /></mxCell>
        <mxCell id="r1cat" value="null" style="text;html=1;align=center;fontSize=11;strokeColor=#000000;fillColor=#d5e8d4;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="490" y="1050" width="130" height="28" as="geometry" /></mxCell>
