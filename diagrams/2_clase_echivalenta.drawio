        <mxCell id="th_qty" value="&lt;b&gt;quantity&lt;/b&gt;" style="text;html=1;align=center;fontSize=12;strokeColor=#000000;fillColor=#f5f5f5;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="390" y="1020" width="100" height="30" as="geometry" />
