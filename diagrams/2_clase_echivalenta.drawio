        <mxCell id="r4c" value="G&lt;sub&gt;4&lt;/sub&gt;" style="text;html=1;align=center;fontSize=11;strokeColor=#000000;fillColor=#f8cecc;" vertex="1" parent="1"><mxGeometry x="100" y="1134" width="60" height="28" as="geometry" /></mxCell>
