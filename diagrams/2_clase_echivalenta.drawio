        <mxCell id="r2cat" value="'books'" style="text;html=1;align=center;fontSize=11;strokeColor=#000000;fillColor=#d5e8d4;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="490" y="1078" width="130" height="28" as="geometry" /></mxCell>
        <mxCell id="r2e" value="produs adaugat in cos cu categorie" style="text;html=1;align=left;fontSize=11;strokeColor=#000000;fillColor=#d5e8d4;" vertex="1" parent="1"><mxGeometry x="620" y="1078" width="550" height="28" as="geometry" /></mxCell>

        <!-- Row G3 -->
        <mxCell id="r3c" value="G&lt;sub&gt;3&lt;/sub&gt;" style="text;html=1;align=center;fontSize=11;strokeColor=#000000;fillColor=#f8cecc;" vertex="1" parent="1"><mxGeometry x="100" y="1106" width="60" height="28" as="geometry" /></mxCell>
        <mxCell id="r3n" value="''" style="text;html=1;align=center;fontSize=11;strokeColor=#000000;fillColor=#f8cecc;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="160" y="1106" width="130" height="28" as="geometry" /></mxCell>
        <mxCell id="r3p" value="50" style="text;html=1;align=center;fontSize=11;strokeColor=#000000;fillColor=#f8cecc;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="290" y="1106" width="100" height="28" as="geometry" /></mxCell>
        <mxCell id="r3q" value="1" style="text;html=1;align=center;fontSize=11;strokeColor=#000000;fillColor=#f8cecc;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="390" y="1106" width="100" height="28" as="geometry" /></mxCell>
        <mxCell id="r3cat" value="null" style="text;html=1;align=center;fontSize=11;strokeColor=#000000;fillColor=#f8cecc;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="490" y="1106" width="130" height="28" as="geometry" /></mxCell>
