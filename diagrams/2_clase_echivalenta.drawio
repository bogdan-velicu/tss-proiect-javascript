        <mxCell id="r5p" value="0" style="text;html=1;align=center;fontSize=11;strokeColor=#000000;fillColor=#f8cecc;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="290" y="1162" width="100" height="28" as="geometry" /></mxCell>
        <mxCell id="r5q" value="1" style="text;html=1;align=center;fontSize=11;strokeColor=#000000;fillColor=#f8cecc;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="390" y="1162" width="100" height="28" as="geometry" /></mxCell>
        <mxCell id="r5cat" value="null" style="text;html=1;align=center;fontSize=11;strokeColor=#000000;fillColor=#f8cecc;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="490" y="1162" width="130" height="28" as="geometry" /></mxCell>
        <mxCell id="r5e" value="throws 'Price must be at least 0.01'" style="text;html=1;align=left;fontSize=11;strokeColor=#000000;fillColor=#f8cecc;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="620" y="1162" width="550" height="28" as="geometry" /></mxCell>

        <!-- Row G6 -->
