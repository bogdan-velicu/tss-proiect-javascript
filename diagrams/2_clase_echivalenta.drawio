        <!-- Row G5 -->
        <mxCell id="r5c" value="G&lt;sub&gt;5&lt;/sub&gt;" style="text;html=1;align=center;fontSize=11;strokeColor=#000000;fillColor=#f8cecc;" vertex="1" parent="1"><mxGeometry x="100" y="1162" width="60" height="28" as="geometry" /></mxCell>
