        <!-- Row G2 -->
        <mxCell id="r2c" value="G&lt;sub&gt;2&lt;/sub&gt;" style="text;html=1;align=center;fontSize=11;strokeColor=#000000;fillColor=#d5e8d4;" vertex="1" parent="1"><mxGeometry x="100" y="1078" width="60" height="28" as="geometry" /></mxCell>
        <mxCell id="r2n" value="'Carte'" style="text;html=1;align=center;fontSize=11;strokeColor=#000000;fillColor=#d5e8d4;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="160" y="1078" width="130" height="28" as="geometry" /></mxCell>
        <mxCell id="r2p" value="29.99" style="text;html=1;align=center;fontSize=11;strokeColor=#000000;fillColor=#d5e8d4;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="290" y="1078" width="100" height="28" as="geometry" /></mxCell>
