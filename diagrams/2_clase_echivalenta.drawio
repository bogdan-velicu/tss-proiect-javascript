<mxfile host="app.diagrams.net" modified="2026-04-26T00:00:00.000Z" agent="draw.io" type="device">
  <diagram id="ep" name="Clase de Echivalenta">
    <mxGraphModel dx="1600" dy="1200" grid="0" gridSize="10" guides="1" tooltips="1" connect="0" arrows="0" fold="0" page="1" pageScale="1" pageWidth="1600" pageHeight="1400" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== TITLE ===== -->
        <mxCell id="title" value="&lt;b&gt;Partitionare in Clase de Echivalenta&lt;/b&gt;&lt;br&gt;Functie: &lt;i&gt;addItem(name, price, quantity, category)&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="1200" height="50" as="geometry" />
        </mxCell>

        <!-- ===== SECTION 1: INPUT DOMAIN ===== -->
        <mxCell id="s1_title" value="&lt;b&gt;1. Domeniul de intrari&lt;/b&gt;" style="text;html=1;align=left;fontSize=13;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="100" y="85" width="400" height="25" as="geometry" />
        </mxCell>
        <mxCell id="s1_body" value="Exista 4 intrari:&lt;br&gt;- &lt;b&gt;name&lt;/b&gt;: sir de caractere (numele produsului)&lt;br&gt;- &lt;b&gt;price&lt;/b&gt;: numar real (pretul in RON)&lt;br&gt;- &lt;b&gt;quantity&lt;/b&gt;: numar intreg (cantitatea)&lt;br&gt;- &lt;b&gt;category&lt;/b&gt;: sir de caractere sau null (categoria produsului)" style="text;html=1;align=left;fontSize=12;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="100" y="110" width="600" height="90" as="geometry" />
        </mxCell>

        <!-- ===== SECTION 2: CLASSES PER VARIABLE ===== -->
        <mxCell id="s2_title" value="&lt;b&gt;2. Clase de echivalenta per variabila&lt;/b&gt;" style="text;html=1;align=left;fontSize=13;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="100" y="215" width="500" height="25" as="geometry" />
        </mxCell>

        <!-- name classes -->
        <mxCell id="name_hdr" value="&lt;b&gt;name&lt;/b&gt; — trebuie sa fie sir nevid (non-whitespace):" style="text;html=1;align=left;fontSize=12;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="100" y="248" width="600" height="20" as="geometry" />
        </mxCell>
        <mxCell id="name_classes" value="N&lt;sub&gt;1&lt;/sub&gt; = { name | typeof name = 'string' ∧ name.trim() ≠ '' }     &lt;i&gt;[valid]&lt;/i&gt;    Ex: 'Laptop', 'Carte'&lt;br&gt;N&lt;sub&gt;2&lt;/sub&gt; = { name | typeof name = 'string' ∧ name.trim() = '' }     &lt;i&gt;[invalid]&lt;/i&gt;  Ex: '', '   '&lt;br&gt;N&lt;sub&gt;3&lt;/sub&gt; = { name | typeof name ≠ 'string' }                         &lt;i&gt;[invalid]&lt;/i&gt;  Ex: 123, null, undefined" style="text;html=1;align=left;fontSize=12;strokeColor=none;fillColor=none;verticalAlign=top;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="120" y="270" width="900" height="60" as="geometry" />
        </mxCell>

        <!-- price classes -->
        <mxCell id="price_hdr" value="&lt;b&gt;price&lt;/b&gt; — numar real in [0.01, 999999.99]:" style="text;html=1;align=left;fontSize=12;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="100" y="340" width="600" height="20" as="geometry" />
        </mxCell>
        <mxCell id="price_classes" value="P&lt;sub&gt;1&lt;/sub&gt; = { p | p ∈ ℝ ∧ 0.01 ≤ p ≤ 999999.99 }   &lt;i&gt;[valid]&lt;/i&gt;    Ex: 29.99, 100, 2500&lt;br&gt;P&lt;sub&gt;2&lt;/sub&gt; = { p | p ∈ ℝ ∧ p &lt; 0.01 }                 &lt;i&gt;[invalid]&lt;/i&gt;  Ex: 0, -5&lt;br&gt;P&lt;sub&gt;3&lt;/sub&gt; = { p | p ∈ ℝ ∧ p &gt; 999999.99 }            &lt;i&gt;[invalid]&lt;/i&gt;  Ex: 1000000&lt;br&gt;P&lt;sub&gt;4&lt;/sub&gt; = { p | typeof p ≠ 'number' ∨ isNaN(p) }       &lt;i&gt;[invalid]&lt;/i&gt;  Ex: 'abc', NaN" style="text;html=1;align=left;fontSize=12;strokeColor=none;fillColor=none;verticalAlign=top;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="120" y="362" width="900" height="80" as="geometry" />
        </mxCell>

        <!-- quantity classes -->
        <mxCell id="qty_hdr" value="&lt;b&gt;quantity&lt;/b&gt; — numar intreg in [1, 50]:" style="text;html=1;align=left;fontSize=12;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="100" y="452" width="600" height="20" as="geometry" />
        </mxCell>
        <mxCell id="qty_classes" value="Q&lt;sub&gt;1&lt;/sub&gt; = { q | q ∈ ℤ ∧ 1 ≤ q ≤ 50 }          &lt;i&gt;[valid]&lt;/i&gt;    Ex: 1, 25, 50&lt;br&gt;Q&lt;sub&gt;2&lt;/sub&gt; = { q | q ∈ ℤ ∧ q ≤ 0 }                &lt;i&gt;[invalid]&lt;/i&gt;  Ex: 0, -1&lt;br&gt;Q&lt;sub&gt;3&lt;/sub&gt; = { q | q ∈ ℤ ∧ q &gt; 50 }                &lt;i&gt;[invalid]&lt;/i&gt;  Ex: 51, 100&lt;br&gt;Q&lt;sub&gt;4&lt;/sub&gt; = { q | q ∉ ℤ }                         &lt;i&gt;[invalid]&lt;/i&gt;  Ex: 2.5, 'five'" style="text;html=1;align=left;fontSize=12;strokeColor=none;fillColor=none;verticalAlign=top;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="120" y="474" width="900" height="80" as="geometry" />
        </mxCell>

        <!-- category classes -->
        <mxCell id="cat_hdr" value="&lt;b&gt;category&lt;/b&gt; — una din {'electronics', 'clothing', 'food', 'books'} sau null:" style="text;html=1;align=left;fontSize=12;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="100" y="564" width="700" height="20" as="geometry" />
        </mxCell>
        <mxCell id="cat_classes" value="C&lt;sub&gt;1&lt;/sub&gt; = { null }                                                 &lt;i&gt;[valid]&lt;/i&gt;    Ex: null&lt;br&gt;C&lt;sub&gt;2&lt;/sub&gt; = { c | c ∈ {'electronics','clothing','food','books'} }   &lt;i&gt;[valid]&lt;/i&gt;    Ex: 'electronics', 'food'&lt;br&gt;C&lt;sub&gt;3&lt;/sub&gt; = { c | c ≠ null ∧ c ∉ {'electronics','clothing','food','books'} }  &lt;i&gt;[invalid]&lt;/i&gt;  Ex: 'sports', 'toys'" style="text;html=1;align=left;fontSize=12;strokeColor=none;fillColor=none;verticalAlign=top;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="120" y="586" width="1050" height="60" as="geometry" />
        </mxCell>

        <!-- ===== SECTION 3: GLOBAL CLASSES ===== -->
        <mxCell id="s3_title" value="&lt;b&gt;3. Clase de echivalenta globale&lt;/b&gt;" style="text;html=1;align=left;fontSize=13;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="100" y="662" width="500" height="25" as="geometry" />
        </mxCell>
        <mxCell id="s3_note" value="Clasele invalide sunt independente — fiecare valoare invalida dintr-o variabila determina eroare indiferent de celelalte.&lt;br&gt;Clasele globale valide se obtin prin combinarea N&lt;sub&gt;1&lt;/sub&gt; × P&lt;sub&gt;1&lt;/sub&gt; × Q&lt;sub&gt;1&lt;/sub&gt; × {C&lt;sub&gt;1&lt;/sub&gt;, C&lt;sub&gt;2&lt;/sub&gt;}. Se disting 11 clase globale:" style="text;html=1;align=left;fontSize=12;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="100" y="690" width="1100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s3_classes" value="G&lt;sub&gt;1&lt;/sub&gt;  = { (name, price, qty, cat) | name ∈ N&lt;sub&gt;1&lt;/sub&gt; ∧ price ∈ P&lt;sub&gt;1&lt;/sub&gt; ∧ qty ∈ Q&lt;sub&gt;1&lt;/sub&gt; ∧ cat = null }          &lt;i&gt;[valid - fara categorie]&lt;/i&gt;&lt;br&gt;G&lt;sub&gt;2&lt;/sub&gt;  = { (name, price, qty, cat) | name ∈ N&lt;sub&gt;1&lt;/sub&gt; ∧ price ∈ P&lt;sub&gt;1&lt;/sub&gt; ∧ qty ∈ Q&lt;sub&gt;1&lt;/sub&gt; ∧ cat ∈ C&lt;sub&gt;2&lt;/sub&gt; }         &lt;i&gt;[valid - cu categorie]&lt;/i&gt;&lt;br&gt;G&lt;sub&gt;3&lt;/sub&gt;  = { (name, price, qty, cat) | name ∈ N&lt;sub&gt;2&lt;/sub&gt; }   &lt;i&gt;[invalid name - sir gol/whitespace]&lt;/i&gt;&lt;br&gt;G&lt;sub&gt;4&lt;/sub&gt;  = { (name, price, qty, cat) | name ∈ N&lt;sub&gt;3&lt;/sub&gt; }   &lt;i&gt;[invalid name - tip gresit]&lt;/i&gt;&lt;br&gt;G&lt;sub&gt;5&lt;/sub&gt;  = { (name, price, qty, cat) | name ∈ N&lt;sub&gt;1&lt;/sub&gt; ∧ price ∈ P&lt;sub&gt;2&lt;/sub&gt; }   &lt;i&gt;[invalid price - sub minim]&lt;/i&gt;&lt;br&gt;G&lt;sub&gt;6&lt;/sub&gt;  = { (name, price, qty, cat) | name ∈ N&lt;sub&gt;1&lt;/sub&gt; ∧ price ∈ P&lt;sub&gt;3&lt;/sub&gt; }   &lt;i&gt;[invalid price - peste maxim]&lt;/i&gt;&lt;br&gt;G&lt;sub&gt;7&lt;/sub&gt;  = { (name, price, qty, cat) | name ∈ N&lt;sub&gt;1&lt;/sub&gt; ∧ price ∈ P&lt;sub&gt;4&lt;/sub&gt; }   &lt;i&gt;[invalid price - tip gresit/NaN]&lt;/i&gt;&lt;br&gt;G&lt;sub&gt;8&lt;/sub&gt;  = { (name, price, qty, cat) | name ∈ N&lt;sub&gt;1&lt;/sub&gt; ∧ price ∈ P&lt;sub&gt;1&lt;/sub&gt; ∧ qty ∈ Q&lt;sub&gt;2&lt;/sub&gt; }   &lt;i&gt;[invalid quantity - zero/negativ]&lt;/i&gt;&lt;br&gt;G&lt;sub&gt;9&lt;/sub&gt;  = { (name, price, qty, cat) | name ∈ N&lt;sub&gt;1&lt;/sub&gt; ∧ price ∈ P&lt;sub&gt;1&lt;/sub&gt; ∧ qty ∈ Q&lt;sub&gt;3&lt;/sub&gt; }   &lt;i&gt;[invalid quantity - peste maxim]&lt;/i&gt;&lt;br&gt;G&lt;sub&gt;10&lt;/sub&gt; = { (name, price, qty, cat) | name ∈ N&lt;sub&gt;1&lt;/sub&gt; ∧ price ∈ P&lt;sub&gt;1&lt;/sub&gt; ∧ qty ∈ Q&lt;sub&gt;4&lt;/sub&gt; }   &lt;i&gt;[invalid quantity - non-intreg]&lt;/i&gt;&lt;br&gt;G&lt;sub&gt;11&lt;/sub&gt; = { (name, price, qty, cat) | name ∈ N&lt;sub&gt;1&lt;/sub&gt; ∧ price ∈ P&lt;sub&gt;1&lt;/sub&gt; ∧ qty ∈ Q&lt;sub&gt;1&lt;/sub&gt; ∧ cat ∈ C&lt;sub&gt;3&lt;/sub&gt; }   &lt;i&gt;[invalid category]&lt;/i&gt;" style="text;html=1;align=left;fontSize=12;strokeColor=none;fillColor=none;verticalAlign=top;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="120" y="733" width="1300" height="220" as="geometry" />
        </mxCell>
        <mxCell id="s3_count" value="11 clase de echivalenta globale" style="text;html=1;align=left;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="958" width="400" height="20" as="geometry" />
        </mxCell>

        <!-- ===== SECTION 4: TABLE ===== -->
        <mxCell id="s4_title" value="&lt;b&gt;4. Reprezentanti (date de test)&lt;/b&gt;" style="text;html=1;align=left;fontSize=13;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="100" y="990" width="500" height="25" as="geometry" />
        </mxCell>

        <!-- Table header row -->
        <mxCell id="th_cls" value="&lt;b&gt;Clasa&lt;/b&gt;" style="text;html=1;align=center;fontSize=12;strokeColor=#000000;fillColor=#f5f5f5;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="100" y="1020" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="th_name" value="&lt;b&gt;name&lt;/b&gt;" style="text;html=1;align=center;fontSize=12;strokeColor=#000000;fillColor=#f5f5f5;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="160" y="1020" width="130" height="30" as="geometry" />
        </mxCell>
        <mxCell id="th_price" value="&lt;b&gt;price&lt;/b&gt;" style="text;html=1;align=center;fontSize=12;strokeColor=#000000;fillColor=#f5f5f5;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="290" y="1020" width="100" height="30" as="geometry" />
